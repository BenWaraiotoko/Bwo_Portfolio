<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd job — auto-deploys portfolio every 15 minutes.

  Install on a new Mac:
    1. Replace YOUR_USERNAME with your macOS username (run `whoami` to check)
    2. cp scripts/com.benwaraiotoko.portfolio-sync.plist \
           ~/Library/LaunchAgents/com.benwaraiotoko.portfolio-sync.plist
    3. launchctl load ~/Library/LaunchAgents/com.benwaraiotoko.portfolio-sync.plist
    4. launchctl list | grep portfolio   ← verify it loaded

  Useful commands:
    tail -f ~/Library/Logs/portfolio-sync.log          watch the log
    launchctl unload ~/Library/LaunchAgents/com.benwaraiotoko.portfolio-sync.plist
    launchctl load  ~/Library/LaunchAgents/com.benwaraiotoko.portfolio-sync.plist
    bash scripts/auto-deploy.sh                        run manually

  Change interval:  900 = 15 min  |  1800 = 30 min  |  3600 = 1 hour
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.benwaraiotoko.portfolio-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/YOUR_USERNAME/Documents/GitHub/Bwo_Portfolio/scripts/auto-deploy.sh</string>
    </array>

    <!-- Run every 15 minutes (900 seconds) -->
    <key>StartInterval</key>
    <integer>900</integer>

    <!-- Don't run immediately on load -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Homebrew on Apple Silicon: /opt/homebrew/bin  |  Intel: /usr/local/bin -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/YOUR_USERNAME</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/Library/Logs/portfolio-sync.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/Library/Logs/portfolio-sync-error.log</string>
</dict>
</plist>
